rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(data) { return signedIn() && data.uid == request.auth.uid; }

    match /trips/{tripId} {
      allow read, update, delete: if owner(resource.data);
      allow create: if owner(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'uid','title','date','days','stops','km','url','status','created'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 200;
    }

    match /sharedTrips/{shareId} {
      allow read: if true;
      allow create: if owner(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'uid','tripId','title','date','days','stops','km','url','created'
        ]);
      allow update, delete: if owner(resource.data);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
