rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // ── ვინ არის ადმინისტრატორი ──────────────────────────────────────────
    // ორი გზა, ერთდროულად:
    //   1. custom claim `admin` — თუ ოდესმე დაყენდება Admin SDK-ით
    //   2. UID-ების სია ქვემოთ — ამას არც გასაღები სჭირდება და არც სკრიპტი
    // მეორე გზა ზუსტად ისეთივე უსაფრთხოა: ამ ფაილის შეცვლა მხოლოდ პროექტის
    // მფლობელს შეუძლია, ანუ სიაში თავის დამატება გარედან შეუძლებელია.
    //
    // როგორ შეავსო:
    //   ტელეფონის UID — აპლიკაცია აჩვენებს „შენახვა და შემოწმება"-ს შემდეგ
    //   შენი UID     — Firebase Console → Authentication → Users → User UID
    function adminUids() {
      return [
        'PHONE-UID-AQ-CHASVI',
        'CHEMI-UID-AQ-CHASVI'
      ];
    }
    function admin() {
      return signedIn() && (request.auth.token.admin == true
        || request.auth.uid in adminUids());
    }
    function owner(data) { return signedIn() && data.uid == request.auth.uid; }

    // ── პარტნიორი გამქირავებელი კომპანია ─────────────────────────────────
    // partners/{uid} დოკუმენტს მხოლოდ admin ქმნის. ანუ რეგისტრაცია თავისით
    // არაფერს აძლევს — სანამ შენ არ დაამატებ, ახალი ანგარიში საერთო დაფას
    // ვერ ხედავს.
    function partner() {
      return signedIn()
        && exists(/databases/$(database)/documents/partners/$(request.auth.uid));
    }
    function claimedBy(id, uid) {
      return get(/databases/$(database)/documents/bookingClaims/$(id)).data.uid == uid;
    }
    function member(data) { return signedIn() && request.auth.uid in data.memberIds; }

    match /trips/{id} {
      allow read: if owner(resource.data) || resource.data.visibility == 'public';
      allow create: if owner(request.resource.data) && request.resource.data.title is string
        && request.resource.data.title.size() <= 120 && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 200;
      allow update: if owner(resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if owner(resource.data);
    }
    match /bookings/{id} {
      // A request carries who to call back. Without name and phone the rental
      // program cannot open a booking at all (customer_name is NOT NULL), so
      // both are required here rather than validated only in the browser.
      allow create: if owner(request.resource.data)
        && request.resource.data.keys().hasOnly(['uid','carSlug','carName','start','end','days','drivers','dailyRateGel','rentalGel','depositGel','paymentDueGel','currency','status','paymentStatus','created','name','phone','email','pickup','dropoff','flight','notes','lang','source','pageUrl'])
        && request.resource.data.keys().hasAll(['uid','carSlug','start','end','days','name','phone','status','paymentStatus'])
        && request.resource.data.carSlug is string
        && request.resource.data.carSlug.size() <= 80
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.days is int
        && request.resource.data.days >= 1 && request.resource.data.days <= 365
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 32
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string && request.resource.data.email.size() <= 160))
        && (!request.resource.data.keys().hasAny(['pickup'])
          || (request.resource.data.pickup is string && request.resource.data.pickup.size() <= 160))
        && (!request.resource.data.keys().hasAny(['dropoff'])
          || (request.resource.data.dropoff is string && request.resource.data.dropoff.size() <= 160))
        && (!request.resource.data.keys().hasAny(['flight'])
          || (request.resource.data.flight is string && request.resource.data.flight.size() <= 40))
        && (!request.resource.data.keys().hasAny(['notes'])
          || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        && (!request.resource.data.keys().hasAny(['drivers'])
          || (request.resource.data.drivers is int && request.resource.data.drivers >= 1
            && request.resource.data.drivers <= 9))
        && (!request.resource.data.keys().hasAny(['paymentDueGel'])
          || (request.resource.data.paymentDueGel is number
            && request.resource.data.paymentDueGel >= 0))
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'required';
      // A partner sees a request ONLY after the primary company released it.
      // Nothing here exposes a request that is still `primary`, and nothing
      // exposes one that has been taken.
      allow read: if owner(resource.data) || admin()
        || (partner() && resource.data.offerStage == 'open');
      // Closing the board after winning the race. The claim document is the
      // proof: without it this update is refused, so a partner cannot mark a
      // request as theirs by writing to the booking directly.
      allow update: if partner()
        && resource.data.offerStage == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['offerStage','claimedBy','claimedByName','claimedAt'])
        && request.resource.data.offerStage == 'taken'
        && request.resource.data.claimedBy == request.auth.uid
        && claimedBy(id, request.auth.uid);
      // A customer may only cancel a pending request. Prices, payment and
      // confirmation are server/admin-owned and cannot be forged by the client.
      allow update: if owner(resource.data) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if owner(resource.data) && resource.data.status == 'pending';
      allow update: if admin();
    }
    match /extensionRequests/{id} {
      allow create: if owner(request.resource.data)
        && request.resource.data.bookingId is string
        && request.resource.data.extraDays is int
        && request.resource.data.extraDays >= 1;
      allow read: if owner(resource.data) || admin();
      allow update: if owner(resource.data) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if owner(resource.data) && resource.data.status == 'pending';
      allow update: if admin();
    }
    match /sharedTrips/{id} {
      allow read: if true;
      allow create: if owner(request.resource.data);
      allow update: if owner(resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if owner(resource.data);
    }
    match /groups/{id} {
      allow read: if true;
      allow create: if owner(request.resource.data) && request.resource.data.memberIds == [request.auth.uid];
      allow update: if (owner(resource.data)
          && request.resource.data.uid == resource.data.uid)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds));
      allow delete: if owner(resource.data);
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if owner(request.resource.data) && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && (!request.resource.data.keys().hasAny(['bookingId'])
          || (request.resource.data.bookingId is string
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid));
      allow update: if owner(resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if owner(resource.data);
    }
    match /userPlaces/{id} {
      allow read, delete: if owner(resource.data);
      allow update: if owner(resource.data) && request.resource.data.uid == resource.data.uid;
      allow create: if owner(request.resource.data);
    }
    match /tripMemories/{id} {
      allow read, delete: if owner(resource.data);
      allow update: if owner(resource.data) && request.resource.data.uid == resource.data.uid;
      allow create: if owner(request.resource.data)
        && request.resource.data.tripId is string
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 80;
    }
    match /conversations/{id} {
      allow read: if member(resource.data);
      allow update: if member(resource.data)
        && request.resource.data.memberIds == resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2;
    }
    match /conversations/{id}/messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.memberIds
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
    }
    // ── Written by the rental program (Fleet Freak), read by everyone ──────
    // fleet/{slug}        — price bands, deposit, photo, how many units exist
    // availability/{slug} — free units per day for the next ~180 days
    // Both are public facts that already appear on the site; only the phone
    // signed in as the admin account may write them.
    match /fleet/{slug}        { allow read: if true; allow write: if admin(); }
    match /availability/{slug} { allow read: if true; allow write: if admin(); }

    // ── საერთო დაფა: „ვინც პირველი, იმისია" ──────────────────────────────
    // დოკუმენტის *შექმნა* არის აღება. Firestore თვითონ უარყოფს იმ
    // დოკუმენტის შექმნას, რომელიც უკვე არსებობს — ანუ N კომპანიიდან ზუსტად
    // ერთი მიიღებს 200-ს, დანარჩენები 409-ს. ეს გადაწყვეტილება ტელეფონში კი
    // არა, საცავშია მიღებული.
    //
    // update და delete სამუდამოდ აკრძალულია: აღებული ჯავშანი ვერავინ
    // წაიღებს, ვერც გამარჯვებული და ვერც სხვა.
    match /bookingClaims/{id} {
      allow read: if partner() || admin();
      allow create: if (partner() || admin())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','companyName','claimedAt'])
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() <= 120
        && get(/databases/$(database)/documents/bookings/$(id)).data.offerStage == 'open';
      allow update, delete: if false;
    }

    // ვინ არის დაშვებული დაფაზე. მხოლოდ admin წერს.
    match /partners/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if admin();
    }

    // კომპანიის სახელი, რომ „აიღო ალფამ" დაიწეროს და არა uid.
    match /companies/{uid} {
      allow read: if partner() || admin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','active','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120;
      allow delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
